# ---------------------------------------------------------------------------
# Cluster Console — environment template
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Control plane API -----------------------------------------------------
API_ADDR=0.0.0.0:8080
API_PUBLIC_URL=http://localhost:8080
# 32+ byte random string: openssl rand -base64 48
JWT_SECRET=TheGratestSeacreatEverImaginedThatIsAlsoVeryLongAndSecure
# Access-token lifetime in hours
JWT_TTL_HOURS=24
# Seeded only when the users table is empty. Change these values in your local
# .env file before first startup; password changes are optional.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123@
# SQLite file for v1 (see docs/architecture.md, decision D3)
DATABASE_PATH=./data/control.db
# Where the control plane reaches the node daemon
DAEMON_URL=http://127.0.0.1:9090

# --- Node daemon -----------------------------------------------------------
# Bind loopback only; production terminates TLS in front of it.
DAEMON_ADDR=127.0.0.1:9090
# Shared secret for HMAC-SHA256 request signing. Must match the API exactly.
# Generate with: openssl rand -hex 32
DAEMON_SHARED_SECRET=change-me

# --- Docker / game servers -------------------------------------------------
DOCKER_HOST=unix:///var/run/docker.sock
# Dedicated user-defined bridge; created automatically by the daemon.
MC_NETWORK=mc-net
MC_IMAGE=itzg/minecraft-server:latest
# Dedicated image selected automatically for Bedrock servers.
MC_BEDROCK_IMAGE=itzg/minecraft-bedrock-server:latest
# Absolute host path preferred; canonicalised at daemon startup.
MC_DATA_ROOT=./data/servers
BACKUP_ROOT=./data/backups
# Host port ranges allocated to game servers
MC_PORT_RANGE_START=25565
MC_PORT_RANGE_END=25664

# --- Frontend (Vite dev only; production is served by Nginx) ----------------
VITE_API_BASE=/api
